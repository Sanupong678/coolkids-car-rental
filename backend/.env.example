# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
# Other origins of the same site, comma-separated (production: e.g. https://www.coolkidscar.com)
ALLOWED_ORIGINS=

DB_HOST=localhost
DB_PORT=5432
DB_NAME=car_rental
DB_USER=postgres
DB_PASSWORD=

# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
COOKIE_SECRET=
SESSION_TTL_DAYS=30
# Unused this long → session revoked, cookie cleared, sign in again
STAFF_IDLE_HOURS=12
CUSTOMER_IDLE_HOURS=72

# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web application)
# Authorised redirect URI: ${APP_URL}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# developers.facebook.com → My Apps → Facebook Login
# Valid OAuth Redirect URI: ${APP_URL}/api/v1/auth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# developers.line.biz → LINE Login channel (enable OpenID Connect + email permission)
# Callback URL: ${APP_URL}/api/v1/auth/line/callback
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=

# LIFF app on the LINE Login channel (developers.line.biz → LINE Login → LIFF → Add).
# Endpoint URL: ${FRONTEND_URL}  ·  Size: Full  ·  Scopes: openid, profile.
# Rich menu links then look like https://liff.line.me/<LIFF_ID>/book
LIFF_ID=

# LINE Official Account → Messaging API channel (same *provider* as the LINE Login channel,
# so both see the same LINE user id). Long-lived channel access token + channel secret.
# Webhook URL: ${APP_URL}/api/v1/webhooks/line  (turn "Use webhook" on)
LINE_MESSAGING_ACCESS_TOKEN=
LINE_MESSAGING_CHANNEL_SECRET=

# Google Cloud → enable Places API (New), Geocoding API, Routes API. Server key — restrict by IP.
GOOGLE_MAPS_API_KEY=

# Object storage, S3-compatible (Cloudflare R2 / Backblaze B2 / AWS S3). Empty → local folders
# (backend/uploads, backend/storage). After filling it in, copy old local files: npm run storage:migrate
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_PUBLIC=
S3_BUCKET_PRIVATE=

# Chrome/Chromium for contract PDFs. Empty → auto-detect (the Docker image installs Chromium).
CHROME_PATH=

# Payments: auto | stripe | mock. auto = stripe when STRIPE_SECRET_KEY is set, else mock (dev only).
# Stripe webhook endpoint: ${APP_URL}/api/v1/webhooks/stripe (event: checkout.session.completed)
PAYMENT_PROVIDER=auto
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PromptPay transfer (โอน = จอง). The QR carries the exact reservation fee.
# Company tax id 0115569024211, or the phone number the shop's PromptPay is registered to.
PROMPTPAY_ID=
PROMPTPAY_NAME=คลูคิท คาร์เร้นท์ทอล
# The shop bank account behind PromptPay (digits). Slips showing only this account can then confirm on their own.
PROMPTPAY_BANK_ACCOUNT=
# Optional automatic slip check (slipok.com). Empty → staff check every slip in the back office.
SLIPOK_BRANCH_ID=
SLIPOK_API_KEY=

# Outgoing e-mail over SMTP. Gmail: smtp.gmail.com, port 465, the shop's Gmail address and an
# App Password (Google account → Security → 2-Step Verification → App passwords).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Staff who get an e-mail (customer details + ID / licence photos) when a booking is sent for review. Comma-separated.
ADMIN_NOTIFY_EMAILS=

# Back-office login created by `npm run db:seed:admin`. Change before going live.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=

# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PII_ENCRYPTION_KEY=
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
PII_HMAC_KEY=

# Comma-separated emails granted super_admin on sign-in (bootstrap only)
BOOTSTRAP_SUPER_ADMINS=

LOG_LEVEL=info
