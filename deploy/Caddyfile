# HTTPS in front of the web container. Caddy gets and renews the Let's Encrypt
# certificate on its own (ports 80 and 443 must reach this VPS).
# Works with DNS straight to the VPS or behind Cloudflare's proxy (SSL mode "Full (strict)"):
# requests arriving from Cloudflare's ranges take the visitor's IP from CF-Connecting-IP.
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

{$SITE_DOMAIN} {
	encode zstd gzip
	# one Server header is enough, and it need not name the software
	header -Server
	reverse_proxy web:8080 {
		# nginx reads the visitor's IP from here for its per-IP limits (see frontend/nginx.conf)
		header_up X-Real-IP {client_ip}
	}
}

www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}
