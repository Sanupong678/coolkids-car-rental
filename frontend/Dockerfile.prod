# Production image: build the SPA, serve it with nginx (non-root, read-only friendly).
#   docker build -f Dockerfile.prod -t coolkids-web .
FROM node:24-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM nginxinc/nginx-unprivileged:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY proxy_params_ck /etc/nginx/proxy_params_ck
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080
