# Proxy settings shared by the /api and /uploads locations in nginx.conf.
proxy_http_version 1.1;
proxy_set_header Connection "";
proxy_set_header Host $host;
proxy_set_header X-Real-IP $remote_addr;
# Overwrite (not append) so clients cannot spoof their IP for the API's rate limits.
proxy_set_header X-Forwarded-For $remote_addr;
proxy_set_header X-Forwarded-Proto $forwarded_proto;
proxy_read_timeout 30s;
proxy_hide_header X-Powered-By;
# nginx.conf sets the browser security headers for every response; drop the API's own
# copies (helmet) so each header is sent once. Cross-Origin-Resource-Policy is kept:
# only the API sets it (public car photos are cross-origin for e-mails).
proxy_hide_header Content-Security-Policy;
proxy_hide_header Strict-Transport-Security;
proxy_hide_header X-Frame-Options;
proxy_hide_header X-Content-Type-Options;
proxy_hide_header Referrer-Policy;
proxy_hide_header Cross-Origin-Opener-Policy;
