# Browser security headers, included by every nginx block that sets its own headers:
# nginx drops the server-level add_header lines in any location that has an add_header
# of its own (that is how /assets/ once lost HSTS and Permissions-Policy).
# 'unsafe-inline' styles: Vue's :style bindings need them; scripts stay 'self' only.
# No Cross-Origin-Embedder-Policy: require-corp would block Google Fonts and the
# external images (OpenStreetMap tiles, profile pictures) the site shows.
add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://tile.openstreetmap.org https://images.unsplash.com https://*.googleusercontent.com https://*.fbsbx.com https://profile.line-scdn.net; media-src 'self'; connect-src 'self' https://api.line.me https://liff.line.me https://*.line-scdn.net; frame-src 'self' https://www.openstreetmap.org; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests" always;
add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
add_header X-Frame-Options "SAMEORIGIN" always;
add_header X-Content-Type-Options "nosniff" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
add_header Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()" always;
add_header Cross-Origin-Opener-Policy "same-origin" always;
# Cross-Origin-Resource-Policy is set by each block in nginx.conf: same-site for the app,
# cross-origin for the public images that receipts (PDF), e-mails and link previews load.
